DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xiaotuo
EMAIL_ENABLED=false
# M1 内容数据目录（courses.json + items-<course>.json，格式见 xiaotuo/content.py）
CONTENT_DIR=content
# 仅本地 http 调试时可设 false；线上必须 true
COOKIE_SECURE=true
# 限流阈值倍数，生产保持 1；本地反复跑 e2e 可设 20
RATELIMIT_MULTIPLIER=1
# 本地运行端口与监听地址（python -m xiaotuo）
PORT=13773
HOST=127.0.0.1
